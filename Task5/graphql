
type Query {
  client(id: ID!): Client
}

type Client {
  id: ID!
  name: String
  age: Int
  documents(
    limit: Int
    offset: Int
    type: String
  ): [Document!]!
  relatives(
    limit: Int
    offset: Int
    relationType: String
  ): [Relative!]!
}

type Document {
  id: ID!
  type: String
  number: String
  issueDate: String
  expiryDate: String
}

type Relative {
  id: ID!
  relationType: String
  name: String
  age: Int
}
